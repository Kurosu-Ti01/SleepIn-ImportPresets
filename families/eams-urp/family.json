{
  "name": "东软 EAMS / URP（课表接口）",
  "apiVersion": 1,
  "changePoints": {
    "scheduleAction": "/eams/courseTableForStd.action",
    "scheduleQuery": "",
    "semesterParam": "semester",
    "semesterSelectSelectors": ["#semester", "select[name='semester']", "select#semesterId", "select[name='xnxq']"],
    "sectionTimesSelectors": ["#kbTable td:first-child", "table.kb td:first-child", ".periodTime"],
    "semesterYears": 4,
    "assumedTotalWeeks": 18,
    "responseShape": "json",
    "jsVariableNames": ["activities", "courseTable", "kbData"],
    "rowContainer": { "path": "activities" },
    "weeksEncoding": "text",
    "groupKeyOrder": ["classId", "courseCode"],
    "mergeAdjacentSections": true,
    "fields": {
      "name": "courseName",
      "teacher": "teachers",
      "day": "dayOfWeek",
      "section": "sections",
      "from": "startPeriod",
      "to": "endPeriod",
      "weeks": "weeks",
      "location": "room",
      "classId": "teachingClassId",
      "courseCode": "courseCode"
    }
  }
}
